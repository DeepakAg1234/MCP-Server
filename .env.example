# google-workspace-mcp configuration.
# Names and comments only. Do not put real credentials in this file.

# Process entry. stdio is the local server. http serves Streamable HTTP.
# On Railway, an empty TRANSPORT becomes http.
TRANSPORT=stdio
# HTTP bind. Used when TRANSPORT=http. Hosted deployments set a reachable address.
# On Railway, an empty HOST becomes :: so the platform proxy can connect.
HOST=127.0.0.1
PORT=8080
MCP_PATH=/mcp
# Required when TRANSPORT=http. Leave empty for stdio and the CLI.
# On Railway, an empty value becomes https://$RAILWAY_PUBLIC_DOMAIN.
PUBLIC_BASE_URL=

# Caller principal for the local CLI and the stdio server.
TENANT_ID=local
USER_ID=local

# HTTP caller auth. Required in production when TRANSPORT=http.
MCP_AUTHORIZATION_SERVER=
# Defaults to PUBLIC_BASE_URL when empty.
MCP_RESOURCE_AUDIENCE=
MCP_TENANT_CLAIM=tenant_id
# Used when the tenant claim is absent. Empty falls back to TENANT_ID.
DEFAULT_TENANT_ID=
# Development only. Refused when NODE_ENV=production.
# One entry, or comma-separated sha256, sha256|userId, or sha256|tenantId|userId.
MCP_DEV_BEARER_SHA256=
NODE_ENV=development

# Google OAuth client. Use a Desktop client for the local loopback flow.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Ignored while the loopback listener chooses the port. Required when TRANSPORT=http.
# On Railway, an empty value becomes $PUBLIC_BASE_URL/oauth/google/callback.
GOOGLE_REDIRECT_URI=
# Set only when the Desktop client is registered with a fixed port. Empty means ephemeral.
OAUTH_LOOPBACK_PORT=
OAUTH_STATE_TTL_SECONDS=600

# Token store. Use postgres when TRANSPORT=http and more than one replica may run.
# On Railway, an empty TOKEN_STORE becomes postgres when DATABASE_URL or TOKEN_STORE_DATABASE_URL is set.
TOKEN_STORE=sqlite
TOKEN_STORE_SQLITE_PATH=./data/tokens.sqlite
# On Railway, an empty value falls back to DATABASE_URL.
TOKEN_STORE_DATABASE_URL=
# 32 bytes, base64. Required before any command opens the store. Generate one locally; do not commit it.
TOKEN_ENCRYPTION_KEY=
# Secret-manager reference. Not supported in Phase 1; set TOKEN_ENCRYPTION_KEY instead.
TOKEN_ENCRYPTION_KEY_REF=

# Optional pin. Empty means the first authorized account for this principal.
DEFAULT_ACCOUNT_ID=
# Documented exception: allow an empty to when cc or bcc has a recipient.
ALLOW_MISSING_TO=false

LOG_LEVEL=info
# false keeps message bodies and document text out of logs.
LOG_CONTENT=false
AUDIT_RETENTION_DAYS=30
AUDIT_RECIPIENT_DOMAINS=true
AUDIT_INCLUDE_RECIPIENTS=false

MAX_RECIPIENTS=50
MAX_SUBJECT_CHARS=998
MAX_BODY_BYTES=262144
MAX_DOC_CONTENT_BYTES=262144
MAX_CONCURRENCY_PER_ACCOUNT=2
RATE_LIMIT_PER_ACCOUNT_PER_MINUTE=20
RATE_LIMIT_PER_PRINCIPAL_PER_MINUTE=60
DOCS_APPEND_MAX_ATTEMPTS=3
# Extra tries for safe transient failures, not counting the first attempt.
UPSTREAM_MAX_ATTEMPTS=2
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LEASE_SECONDS=120

# Allowlists. Comma-separated. Empty means no restriction.
ALLOW_ACCOUNT_IDS=
ALLOW_RECIPIENT_DOMAINS=
ALLOW_BCC_DOMAINS=
ALLOW_DOCUMENT_IDS=

# GET /metrics on the HTTP server. false keeps counters as log lines only.
METRICS_ENABLED=false
# Required to read /metrics from a non-loopback peer. Empty means localhost only.
METRICS_TOKEN=
# HTTP with SQLite exits unless this is true. Use postgres for more than one replica.
ALLOW_SINGLE_REPLICA_SQLITE=false
